# Copy this file to .env and fill in real values. Never commit .env.
#
# On a server, the supported way to produce this file is `./scripts/setup-env.sh`, which
# generates JWT_SECRET, seed admin password and seed super-admin password with strong
# random values and only asks for DB_PASSWORD. Rotation guide: SECURITY.md.
#
# Under SPRING_PROFILES_ACTIVE=docker (the compose default), the backend refuses to boot
# if any of the placeholder values below are still present — see ProductionSecurityCheck.

# PostgreSQL connection.
#
# The compose file now bundles a `postgres` service on the same Docker network as the
# backend. That's the fastest option: query round-trip is <1 ms instead of the 20-80 ms
# you'd get talking to a Postgres on the host (Docker Desktop's vpnkit adds latency) or
# a remote box (public-IP latency). Keep the defaults for the fast path.
#
# To point at a Postgres you already run (host machine, remote server, managed service):
#   DB_DOCKER_HOST=host.docker.internal   # Postgres on the docker host
#   DB_DOCKER_HOST=1.2.3.4                # Postgres on a remote server
# and remove/skip the `postgres` service in docker-compose (or simply don't start it).
DB_HOST=localhost
DB_DOCKER_HOST=postgres
DB_PORT=5432
DB_NAME=dataentry
DB_USERNAME=daleel
DB_PASSWORD=CHANGE-ME-POSTGRES-PASSWORD

# 32+ char random string. Use `openssl rand -base64 48` or `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
JWT_SECRET=CHANGE-ME-MIN-32-CHARS

# Comma-separated allowlist of origins that may call the API with credentialed cookies.
# Wildcards are rejected because they would let any site call the API with the victim's cookie.
# Example: https://app.example.com,https://admin.example.com
APP_CORS_ALLOWED_ORIGINS=http://localhost:8082

# Seed admin credentials (change before first boot). Only used when the users table is
# empty on first startup — existing installs keep whatever the admin's current password is.
APP_SEED_ADMIN_USERNAME=admin
APP_SEED_ADMIN_PASSWORD=CHANGE-ME-STRONG-PASSWORD

# Super-admin is the cross-team operator: it can enter any team as an impersonated admin
# and manage every workspace. Same seed rules — only applied on first boot.
APP_SEED_SUPERADMIN_USERNAME=superadmin
APP_SEED_SUPERADMIN_PASSWORD=CHANGE-ME-STRONG-PASSWORD

# Set to false only for local http:// dev. Real deployments (https) leave true.
APP_AUTH_COOKIE_SECURE=true

# Persist login-rate counters in PostgreSQL across restarts and replicas.
APP_LOGIN_RATE_STORAGE=database

# Rolling 24h upload cap per user (bytes). 500 MB default.
APP_UPLOADS_PER_USER_DAILY_BYTES=524288000

# Self-hosted LibreTranslate (compose file wires this to the sidecar). Leave blank to disable.
TRANSLATION_BASE_URL=http://libretranslate:5000
TRANSLATION_API_KEY=

# Grafana admin login. Required at boot — the compose file refuses to start Grafana
# without GRAFANA_ADMIN_PASSWORD. Change from the default before first boot.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE-ME-STRONG-PASSWORD
# Only needs to be set when Grafana is exposed via a public URL (Neurix proxy label);
# leave the localhost default for internal-only access.
GRAFANA_ROOT_URL=http://localhost:3001

# Alertmanager delivery is NOT configured via env — the ships-silent default keeps alerts
# visible in the UI but sends nothing until an operator edits
# monitoring/alertmanager/alertmanager.yml to add a webhook_configs / slack_configs /
# email_configs block. See RUNBOOK.md `Wiring alert delivery`.

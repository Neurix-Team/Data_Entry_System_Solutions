# Local dev secrets — NEVER commit this file.  Rotate before deploying anywhere real.
JWT_SECRET=local-dev-secret-please-rotate-me-with-a-real-random-string-32chars-min
# "*" works for arbitrary IP-based deployments. Tighten to a strict list in production.
APP_CORS_ALLOWED_ORIGINS=*
APP_SEED_ADMIN_USERNAME=admin
APP_SEED_ADMIN_PASSWORD=admin123
# Local dev serves the frontend on plain http:// so browsers refuse Secure cookies.
# Flip this back to true (or unset) in real deployments where the site is served over https.
APP_AUTH_COOKIE_SECURE=false
# When running via docker-compose, TRANSLATION_BASE_URL defaults to the self-hosted
# `libretranslate` service.  Uncomment to override or leave blank to fully disable translation:
# TRANSLATION_BASE_URL=
